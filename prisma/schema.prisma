generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Note {
  id        String    @id
  text      String
  createdAt DateTime
  updatedAt DateTime?
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  notes        Note[]
}